generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model user {
  id       BigInt    @id @default(autoincrement())
  name     String
  team_id  BigInt?
  contents content[]
  team     team?     @relation(fields: [team_id], references: [id], onUpdate: NoAction, map: "fk_user_team")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model content {
  id                        BigInt   @id @default(autoincrement())
  created_at                DateTime @default(now()) @db.Timestamptz(6)
  username                  String   @default("")
  content                   String?
  updated_at                DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  attachment_name           String?
  attachment_mime_type      String?
  attachment_size           Int?
  attachment_data           Bytes?
  master_comment            String?
  is_confirm_master_comment Boolean  @default(false)
  user_id                   BigInt?
  user_comment              String?
  is_user_comment           Boolean  @default(false)
  team_id                   BigInt   @default(2)
  team                      team     @relation(fields: [team_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_content_team")
  user                      user?    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_content_user")
}

model division {
  id         BigInt       @id @default(autoincrement())
  created_at DateTime     @default(now()) @db.Timestamptz(6)
  name       String?      @db.VarChar
  department department[]
}

model department {
  id          BigInt    @id @default(autoincrement())
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  name        String?
  division_id BigInt?
  division    division? @relation(fields: [division_id], references: [id], onUpdate: NoAction, map: "fk_department_division")
  team        team[]
}

model team {
  id            BigInt      @id @default(autoincrement())
  created_at    DateTime    @default(now()) @db.Timestamptz(6)
  name          String?     @db.VarChar
  department_id BigInt?
  content       content[]
  department    department? @relation(fields: [department_id], references: [id], onUpdate: NoAction, map: "fk_team_department")
  user          user[]
}
